{
  "mcpServers": {
    "telegram-renderer": {
      "command": "/home/USER/.bun/bin/bun",
      "args": [
        "run",
        "/home/USER/.local/share/claude-code-telegram-kit/current/packages/telegram-renderer-mcp/src/server.ts"
      ],
      "env": {
        "TELEGRAM_TOOL_DISCLOSURE_MODE": "verbose",
        "CLAUDE_PROJECT_SESSIONS_DIR": "/home/USER/.claude/projects/-home-USER-claudio-workspace"
      }
    },
    "session-control": {
      "command": "/home/USER/.bun/bin/bun",
      "args": [
        "run",
        "/home/USER/.local/share/claude-code-telegram-kit/current/packages/session-control-mcp/src/server.ts"
      ],
      "env": {
        "CLAUDE_SESSION_RESET_HELPER": "/usr/local/sbin/claude-code-session-reset",
        "CLAUDE_SESSION_RESET_CONFIG": "/etc/claude-code-telegram-kit/reset.json",
        "CLAUDE_PROJECT_SESSIONS_DIR": "/home/USER/.claude/projects/PROJECT",
        "TELEGRAM_COMMAND_MENU_ENABLED": "true"
      }
    }
  }
}
