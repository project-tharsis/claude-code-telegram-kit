{
  "statusLine": {
    "type": "command",
    "command": "/usr/local/sbin/claude-usage-snapshot --output /home/USER/.local/state/claude-code-telegram-kit/subscription-usage.json"
  },
  "permissions": {
    "allow": [],
    "ask": [],
    "deny": [
      "mcp__plugin_telegram_telegram__reply",
      "mcp__telegram-renderer__bind_turn",
      "mcp__telegram-renderer__record_tool",
      "mcp__telegram-renderer__record_tool_success",
      "mcp__telegram-renderer__record_tool_failure",
      "mcp__telegram-renderer__record_subagent_start",
      "mcp__telegram-renderer__record_subagent_stop",
      "mcp__telegram-renderer__finish_turn",
      "mcp__session-control__dispatch_command"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/sbin/claude-session-start-receipt --directory /home/USER/.local/state/claude-code-telegram-kit/session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/sbin/claude-control-command-guard",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/home/USER/.bun/bin/bun run /home/USER/.local/share/claude-code-telegram-kit/current/packages/session-control-mcp/src/session-title-command.ts",
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "server": "telegram-renderer",
            "tool": "bind_turn",
            "input": {
              "session_id": "${session_id}",
              "prompt_id": "${prompt_id}",
              "prompt": "${prompt}",
              "transcript_path": "${transcript_path}",
              "hook_event_name": "UserPromptSubmit"
            }
          },
          {
            "type": "mcp_tool",
            "server": "session-control",
            "tool": "dispatch_command",
            "timeout": 30,
            "input": {
              "session_id": "${session_id}",
              "prompt_id": "${prompt_id}",
              "prompt": "${prompt}",
              "hook_event_name": "UserPromptSubmit"
            }
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?!mcp__telegram-renderer__|mcp__session-control__).*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "telegram-renderer",
            "tool": "record_tool",
            "input": {
              "session_id": "${session_id}",
              "prompt_id": "${prompt_id}",
              "tool_use_id": "${tool_use_id}",
              "tool_name": "${tool_name}",
              "agent_id": "${agent_id}",
              "command": "${tool_input.command}",
              "file_path": "${tool_input.file_path}",
              "path": "${tool_input.path}",
              "offset": "${tool_input.offset}",
              "limit": "${tool_input.limit}",
              "pattern": "${tool_input.pattern}",
              "query": "${tool_input.query}",
              "url": "${tool_input.url}",
              "skill": "${tool_input.skill}",
              "description": "${tool_input.description}",
              "hook_event_name": "PreToolUse"
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?!mcp__telegram-renderer__|mcp__session-control__).*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "telegram-renderer",
            "tool": "record_tool_success",
            "input": {
              "session_id": "${session_id}",
              "prompt_id": "${prompt_id}",
              "tool_use_id": "${tool_use_id}",
              "hook_event_name": "PostToolUse"
            }
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(?!mcp__telegram-renderer__|mcp__session-control__).*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "telegram-renderer",
            "tool": "record_tool_failure",
            "input": {
              "session_id": "${session_id}",
              "prompt_id": "${prompt_id}",
              "tool_use_id": "${tool_use_id}",
              "hook_event_name": "PostToolUseFailure"
            }
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "telegram-renderer",
            "tool": "record_subagent_start",
            "input": {
              "session_id": "${session_id}",
              "prompt_id": "${prompt_id}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "hook_event_name": "SubagentStart"
            }
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "telegram-renderer",
            "tool": "record_subagent_stop",
            "input": {
              "session_id": "${session_id}",
              "prompt_id": "${prompt_id}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "hook_event_name": "SubagentStop"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "telegram-renderer",
            "tool": "finish_turn",
            "input": {
              "session_id": "${session_id}",
              "prompt_id": "${prompt_id}",
              "last_assistant_message": "${last_assistant_message}",
              "hook_event_name": "Stop"
            }
          },
          {
            "type": "command",
            "command": "/home/USER/.bun/bin/bun run /home/USER/.local/share/claude-code-telegram-kit/current/packages/session-control-mcp/src/session-title-command.ts",
            "timeout": 30
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "telegram-renderer",
            "tool": "finish_turn",
            "input": {
              "session_id": "${session_id}",
              "prompt_id": "${prompt_id}",
              "last_assistant_message": "${last_assistant_message}",
              "error": "${error}",
              "hook_event_name": "StopFailure"
            }
          }
        ]
      }
    ]
  }
}
