{
  "name": "claude-code-telegram-kit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test packages",
    "typecheck": "tsc -p packages/shared/tsconfig.json --noEmit && tsc -p packages/telegram-renderer-mcp/tsconfig.json --noEmit && tsc -p packages/session-control-mcp/tsconfig.json --noEmit",
    "python:test": "python3 -m unittest packages/session-control-mcp/tests/test_reset_helper.py scripts/tests/test_deploy_local.py",
    "python:compile": "python3 -m py_compile packages/session-control-mcp/scripts/claude_code_session_reset.py scripts/deploy_local.py scripts/check_public_tree.py scripts/check_versions.py",
    "privacy:scan": "python3 scripts/check_public_tree.py",
    "version:check": "python3 scripts/check_versions.py",
    "check": "bun run test && bun run typecheck && bun run python:test && bun run python:compile && bun run privacy:scan && bun run version:check"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0",
    "python": ">=3.11"
  },
  "license": "Apache-2.0"
}
